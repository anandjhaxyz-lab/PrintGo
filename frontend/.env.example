# S3K Print Yourself — Customer Frontend Environment Variables
# Copy to .env (local) or configure in Vercel / hosting dashboard.

# Backend API base URL (e.g., http://localhost:5000 locally or https://api.example.com in split-origin)
VITE_API_URL=http://localhost:5000

# Public Customer Mobile URL encoded into permanent printer QR flyers
VITE_MOBILE_URL=http://localhost:5173

# Cashfree SDK runs strictly with public mode returned by backend ('sandbox' | 'production').
# NEVER place CASHFREE_SECRET_KEY or admin secrets in VITE_* variables.
