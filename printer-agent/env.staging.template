# ============================================================
# PrintGo Printer Agent — Staging Environment Configuration
# ============================================================
# Connects physical EPSON L6460 Series printer to Staging Cloud Backend
# ============================================================

# Target Staging Cloud Backend
BACKEND_URL=https://printgo-backend-staging.onrender.com

# Target Physical Printer (verified on Windows USB019)
PRINTER_NAME=EPSON L6460 Series

# Staging Machine Authentication Key
# Copy the dedicated staging machine key from the Render Staging dashboard
# (Matches the MACHINE_KEY environment variable configured on printgo-backend-staging).
# NEVER reuse the production Hyderabad machine key.
MACHINE_KEY=
