# ============================================================
# PrintGo Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. NEVER share it via email/chat.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development
# Set to "production" on Render/deployed environments

# --- Database (PostgreSQL) ---
# Local: postgresql://user:password@localhost:5432/printgo_db?schema=public
# Production: Use a managed PostgreSQL (Render, Supabase, Neon, etc.)
DATABASE_URL="postgresql://admin:CHANGE_ME_STRONG_PASSWORD@localhost:5432/printgo_db?schema=public"

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GENERATE_A_64_BYTE_RANDOM_HEX_STRING"

# --- Admin Bootstrap ---
# These are used ONLY for initial superadmin creation on first login.
# Change immediately after first login via the admin panel.
ADMIN_USER="admin@printgo.in"
ADMIN_PASS="CHANGE_ME_MIN_16_CHARS_MIXED_CASE"

# --- Payment Gateway (Cashfree) ---
# Get from: https://merchant.cashfree.com/merchant/pg/credentials
#
# ⚠️  IMPORTANT: Use SANDBOX keys for development/testing!
# Sandbox keys start with: TEST_xxx / cfsk_ma_test_xxx
# Production keys start with: APP_xxx / cfsk_ma_prod_xxx
#
# Target Cashfree mode: strictly "sandbox" or "production"
CASHFREE_ENV="sandbox"
# NEVER use production keys in development.
CASHFREE_APP_ID="YOUR_SANDBOX_APP_ID"
CASHFREE_SECRET_KEY="YOUR_SANDBOX_SECRET_KEY"
# Optional explicit HTTPS webhook URL (defaults to ${PUBLIC_APP_URL}/api/payments/webhook)
CASHFREE_NOTIFY_URL=""

# Demo 1-click simulated payment endpoint (strictly disabled unless explicitly "true" in non-prod)
ENABLE_DEMO_PAYMENT="false"

# --- Frontend / Public App URL (for CORS & whitelisted payment return URLs) ---
PUBLIC_APP_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# --- AWS S3 (File Storage — optional, not yet active) ---
# Get from: AWS IAM Console → Create user with S3-only policy
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME="printgo-uploads-dev"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_KEY"

# --- Redis (BullMQ Print Queue — required in production) ---
# Render Key Value: prefer its internal connection URL from the Connect menu.
# The URL must use redis:// or rediss:// and must be stored as a secret env var.
# Legacy host/port/password settings remain supported for existing deployments.
# Production runtime fails closed if neither REDIS_URL nor REDIS_HOST is configured.
REDIS_URL=""
REDIS_HOST=""
REDIS_PORT=6379
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_TLS="false"
# Set true to require Redis outside NODE_ENV=production (e.g. in a dedicated staging environment).
QUEUE_REDIS_REQUIRED="false"
# Enable only when Socket.IO needs cross-instance fan-out.
ENABLE_REDIS_ADAPTER="false"

# --- Sentry (Error Monitoring — optional) ---
# Get from: https://sentry.io/
SENTRY_DSN=""
